# Resend email (free: 3,000/month — get key at resend.com)
RESEND_API_KEY=re_your_key_here
RESEND_FROM=InvoiceApp <noreply@yourdomain.com>

# App base URL (used in reset-password email link)
APP_BASE_URL=http://localhost:5173

STORAGE_PATH=storage/invoices

WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=2000
REMINDER_POLL_SECONDS=60
DB_URL=jdbc:postgresql://localhost:5432/invoice
DB_USERNAME=invoice
DB_PASSWORD=invoice

# JWT signing secret (must be >= 32 bytes / 256 bits for HS256)
JWT_SECRET=super-secret-dev-key-change-in-production-must-be-long-enough-256bit

# Token lifetimes
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7




